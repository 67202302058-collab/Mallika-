  if(!ignoreDate && (r[0]<S.from || r[0]>S.to)) return false;
  if(S.sex!=='' && r[2]!==+S.sex) return false;
  if(S.age!=='' && r[3]!==+S.age) return false;
  if(S.risk!=='' && r[4]!==+S.risk) return false;
  if(!ignoreProv && S.prov>=0 && r[1]!==S.prov) return false;
  return true;
}
function compute(){
  const R = rows();
  const byProv = new Float64Array(NP);   // all provinces (map/table/top10) -- ignores selected province
  const byDay = new Float64Array(ND);    // epi curve: honours selected province, ignores date range for context
  const byDayNat = new Float64Array(ND);
  const pyr = Array.from({length:D.age.length},()=>[0,0,0]);
  const risk = new Float64Array(D.risk.length);
  let total=0, totalSel=0;
  for(const r of R){
