}
function featIdx(f){
  const p=f.properties||{};
  for(const k of NAME_KEYS){ if(p[k]!=null){ const i=provIdx.get(normName(p[k])); if(i!==undefined) return i; } }
  for(const k in p){ const i=provIdx.get(normName(p[k])); if(i!==undefined) return i; }
