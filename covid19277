  const choro = geoOK && S.style==='choro';
  const pal = isDark()?PAL_D:PAL_L;
  const labelOf = v => S.metric==='share' ? pct(tot?v/tot:0)+' ('+fmt(v)+' ราย)' : fmt(v)+' ราย';
  if(geoLayer){
    geoLayers.forEach((ly,i)=>{
      if(!ly) return;
      if(choro){
        if(!map.hasLayer(ly)) ly.addTo(map);
        ly.setStyle({fillColor:pal[classOf(vals[i],max)],fillOpacity:.88,color:i===S.prov?cssv('--accent3'):cssv('--card'),weight:i===S.prov?3:.8});
        ly.unbindTooltip(); ly.bindTooltip('<div class="tip"><b>'+D.provs[i][0]+'</b><br>'+labelOf(vals[i])+'</div>',{sticky:true});
        if(i===S.prov) ly.bringToFront();
      } else if(map.hasLayer(ly)) map.removeLayer(ly);
    });
  }
  D.provs.forEach((p,i)=>{
    const c=circles[i];
    if(choro){ c.setRadius(0); c.setStyle({opacity:0,fillOpacity:0}); c.unbindTooltip(); return; }
    const v=vals[i];
    c.setStyle({color:col,fillColor:col,opacity:1,weight:i===S.prov?3:1.5,fillOpacity:i===S.prov?.7:.45});
    c.setRadius(radius(v,max));
    c.unbindTooltip();
    c.bindTooltip('<div class="tip"><b>'+p[0]+'</b><br>'+labelOf(v)+'</div>',{direction:'top'});
    if(i===S.prov) c.bringToFront();
  });
  // legend
  const head='<b>'+(S.frame!==null?'รายวัน':'ตามช่วงที่เลือก')+'</b>';
  if(choro){
    const lo=[0,...BRK.slice(1).map(t=>Math.round(t*t*max))];
    let rows='';
    for(let k=5;k>=1;k--){
      const a=Math.max(1,(k===1?1:Math.round(BRK[k-1]*BRK[k-1]*max)+1)), b=(k===5?Math.round(max):Math.round(BRK[k]*BRK[k]*max));
      rows+='<div class="r"><i style="width:14px;height:14px;border-radius:3px;opacity:1;background:'+pal[k]+'"></i>'+(k===5?'> '+fmt(Math.round(BRK[4]*BRK[4]*max)):fmt(a)+' – '+fmt(b))+'</div>';
    }
    rows+='<div class="r"><i style="width:14px;height:14px;border-radius:3px;opacity:1;background:'+pal[0]+'"></i>0</div>';
    $('legend').innerHTML=head+rows;
  } else {
    const steps=[max, max/4, max/16].map(x=>Math.max(1,Math.round(x)));
    $('legend').innerHTML=head+[...new Set(steps)].map(v=>{
      const r=radius(v,max); return '<div class="r"><i style="width:'+2*r+'px;height:'+2*r+'px"></i>'+fmt(v)+'</div>';
    }).join('');
  }
  $('mapCap').textContent = S.frame!==null ? thDate(D.dates[S.frame],true) : thDate(D.dates[S.from],false)+' – '+thDate(D.dates[S.to],true);
}
function frameVals(){
  const v=new Float64Array(NP);
  for(const r of rows()){ if(r[0]!==S.frame) continue; if(!passes(r,true,true)) continue; v[r[1]]+=r[5]; }
  return v;
}

/* ---------- charts ---------- */
Chart.defaults.font.family="'Sarabun','TH Sarabun New',Tahoma,sans-serif";
Chart.defaults.font.size=12;
const charts={};
function chartColors(){
  return {ink:cssv('--ink'),muted:cssv('--muted'),line:cssv('--line'),a:cssv('--accent'),b:cssv('--accent2'),c:cssv('--accent3')};
}
function mk(id,cfg){ if(charts[id]) charts[id].destroy(); charts[id]=new Chart($(id),cfg); }
function ma7(arr){ return arr.map((_,i)=>{ if(i<6) return null; let s=0; for(let k=i-6;k<=i;k++) s+=arr[k]; return s/7; }); }

function drawCharts(c){
  const K=chartColors();
  Chart.defaults.color=K.muted; Chart.defaults.borderColor=K.line;
  // epi curve
  const labels=D.dates.map(d=>thDate(d,false));
  const inRange=D.dates.map((_,i)=>i>=S.from&&i<=S.to);
  const ser=Array.from(c.byDay);
  mk('epi',{type:'bar',data:{labels,datasets:[
    {type:'bar',label:'รายวัน',data:ser,backgroundColor:ser.map((_,i)=>inRange[i]?K.a:K.line),order:2},
    {type:'line',label:'ค่าเฉลี่ย 7 วัน',data:ma7(ser),borderColor:K.b,backgroundColor:K.b,pointRadius:0,borderWidth:2.5,tension:.3,order:1}
  ]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},
    plugins:{legend:{position:'bottom',labels:{boxWidth:12}},tooltip:{callbacks:{label:t=>t.dataset.label+': '+fmt(t.parsed.y)}}},
    scales:{x:{ticks:{maxRotation:60,autoSkip:true,maxTicksLimit:10},grid:{display:false}},y:{beginAtZero:true,ticks:{callback:v=>fmt(v)}}}}});
  $('epiCap').textContent = S.prov>=0 ? 'เฉพาะจังหวัด'+D.provs[S.prov][0] : 'ทั้งประเทศ';

  // top 10
  const idx=[...c.byProv.keys()].sort((a,b)=>c.byProv[b]-c.byProv[a]).slice(0,10);
  mk('topProv',{type:'bar',data:{labels:idx.map(i=>D.provs[i][0]),datasets:[{data:idx.map(i=>c.byProv[i]),
    backgroundColor:idx.map(i=>i===S.prov?K.c:K.a)}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:t=>fmt(t.parsed.x)+' ราย'}}},
      scales:{x:{ticks:{callback:v=>fmt(v)}},y:{grid:{display:false}}},
      onClick:(e,els)=>{ if(els.length){const i=idx[els[0].index]; S.prov=(S.prov===i?-1:i); update();} }}});

  // pyramid
  const ages=D.age.slice(0,7);
  const f=ages.map((_,i)=>-c.pyr[i][0]), m=ages.map((_,i)=>c.pyr[i][1]);
  mk('pyr',{type:'bar',data:{labels:ages,datasets:[
    {label:'หญิง',data:f,backgroundColor:K.a},{label:'ชาย',data:m,backgroundColor:K.b}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{boxWidth:12}},tooltip:{callbacks:{label:t=>t.dataset.label+': '+fmt(Math.abs(t.parsed.x))}}},
      scales:{x:{stacked:true,ticks:{callback:v=>fmt(Math.abs(v))}},y:{stacked:true,reverse:true,grid:{display:false}}}}});

  // risk
  const ri=[...c.risk.keys()].sort((a,b)=>c.risk[b]-c.risk[a]);
  mk('risk',{type:'bar',data:{labels:ri.map(i=>D.risk[i]),datasets:[{data:ri.map(i=>c.risk[i]),backgroundColor:K.c}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:t=>fmt(t.parsed.x)+' ราย'}}},
      scales:{x:{ticks:{callback:v=>fmt(v)}},y:{grid:{display:false},ticks:{callback:function(v){const l=this.getLabelForValue(v);return l.length>24?l.slice(0,23)+'…':l;}}}}}});
}

/* ---------- tables / kpis ---------- */
function drawTables(c,dm){
  const tot=c.total||1;
  const idx=[...c.byProv.keys()].filter(i=>c.byProv[i]>0).sort((a,b)=>c.byProv[b]-c.byProv[a]);
  const max=c.byProv[idx[0]]||1;
  $('provTbl').tBodies[0].innerHTML = idx.map((i,k)=>
    '<tr data-i="'+i+'" class="'+(i===S.prov?'sel':'')+'"><td>'+(k+1)+'</td><td>'+D.provs[i][0]+'</td><td class="n">'+fmt(c.byProv[i])+
    '</td><td class="n">'+pct(c.byProv[i]/tot)+'</td><td style="width:70px"><span class="bar" style="width:'+Math.max(2,60*c.byProv[i]/max)+'px"></span></td></tr>').join('');
  const di=[...dm.keys()].filter(i=>dm[i]>0).sort((a,b)=>dm[b]-dm[a]).slice(0,20);
  $('distTbl').tBodies[0].innerHTML = di.map((i,k)=>{
    const [p,n]=D.distKeys[i];
    return '<tr><td>'+(k+1)+'</td><td>'+n+'</td><td>'+D.provs[p][0]+'</td><td class="n">'+fmt(dm[i])+'</td></tr>';
  }).join('') || '<tr><td colspan="4" style="color:var(--muted)">ไม่มีข้อมูล</td></tr>';
  $('distCap').textContent = S.prov>=0 ? 'ในจังหวัด'+D.provs[S.prov][0] : 'ทั้งประเทศ (ไม่รวมตัวกรองเพศ/อายุ/ความเสี่ยง)';
}
$('provTbl').tBodies[0].addEventListener('click',e=>{
  const tr=e.target.closest('tr'); if(!tr) return; const i=+tr.dataset.i; S.prov=(S.prov===i?-1:i); update();
});

function drawKpis(c){
  const days = S.to-S.from+1;
  const sumRange = (arr)=>{let s=0;for(let i=S.from;i<=S.to;i++)s+=arr[i];return s;};
  const ser = S.prov>=0 ? c.byDay : c.byDayNat;
  const rangeTotal = sumRange(S.prov>=0?c.byDay:c.byDayNat);
  let peak=-1,pi=S.from; for(let i=S.from;i<=S.to;i++){ if(ser[i]>peak){peak=ser[i];pi=i;} }
  const nProv = [...c.byProv].filter(v=>v>0).length;
  // change: last 7 days vs previous 7 days in selected range
  let chg='–', chgSub='';
  if(days>=14){
    let a=0,b=0; for(let i=0;i<7;i++){ a+=ser[S.to-i]; b+=ser[S.to-7-i]; }
    if(b>0){ const d=(a-b)/b; chg=(d>=0?'+':'')+(d*100).toFixed(1)+'%'; chgSub='7 วันสุดท้าย เทียบ 7 วันก่อนหน้า'; }
  } else chgSub='ต้องเลือกช่วง ≥ 14 วัน';
  const fem=c.pyr.reduce((s,x)=>s+x[0],0), mal=c.pyr.reduce((s,x)=>s+x[1],0);
  // median age (group-based approx via midpoints of known groups)
  let cum=0, kn=c.pyr.slice(0,7).reduce((s,x)=>s+x[0]+x[1]+x[2],0), med='–';
  if(kn>0){ for(let i=0;i<7;i++){ cum+=c.pyr[i][0]+c.pyr[i][1]+c.pyr[i][2]; if(cum>=kn/2){ med=D.age[i]; break; } } }
  const area = S.prov>=0 ? D.provs[S.prov][0] : 'ทั้งประเทศ';
  const items=[
    ['ผู้ป่วยยืนยัน ('+area+')', fmt(c.totalSel), thDate(D.dates[S.from],false)+' – '+thDate(D.dates[S.to],false)],
    ['เฉลี่ยต่อวัน', fmt(c.totalSel/days), 'ช่วง '+days+' วัน'],
    ['วันที่มีผู้ป่วยสูงสุด', fmt(peak<0?0:peak), thDate(D.dates[pi],true)],
    ['แนวโน้ม 7 วัน', chg, chgSub],
    ['สัดส่วนเพศหญิง', mal+fem? pct(fem/(fem+mal)) : '–', 'หญิง '+fmt(fem)+' / ชาย '+fmt(mal)],
    ['กลุ่มอายุมัธยฐาน', med, 'ไม่รวมไม่ทราบอายุ'],
    ['จังหวัดที่พบผู้ป่วย', nProv+' / '+NP, 'ตามตัวกรองที่เลือก']
  ];
  $('kpis').innerHTML = items.map(x=>'<div class="kpi"><div class="t">'+x[0]+'</div><div class="v">'+x[1]+'</div><div class="s">'+x[2]+'</div></div>').join('');
}

function drawChip(){
  $('selChip').innerHTML = S.prov>=0 ? '<span class="chip">จังหวัด'+D.provs[S.prov][0]+' <button type="button" aria-label="ยกเลิกเลือกจังหวัด" id="clrProv">×</button></span>' : '';
  const b=$('clrProv'); if(b) b.onclick=()=>{S.prov=-1;update();};
}

/* ---------- animation ---------- */
let timer=null;
function stop(){ if(timer){clearInterval(timer);timer=null;} S.frame=null; $('playBtn').textContent='▶ เล่นย้อนดูรายวัน'; $('sliderLbl').textContent=''; }
$('playBtn').onclick=()=>{
  if(timer){ stop(); update(); return; }
  S.frame=S.from; $('playBtn').textContent='⏸ หยุด';
  timer=setInterval(()=>{
    S.frame++; if(S.frame>S.to){ stop(); update(); return; }
    $('slider').value=S.frame; frameStep();
  },700);
  $('slider').value=S.frame; frameStep();
};
$('slider').oninput=()=>{
  if(timer){clearInterval(timer);timer=null;$('playBtn').textContent='▶ เล่นย้อนดูรายวัน';}
  S.frame=+$('slider').value; frameStep();
};
function frameStep(){ $('sliderLbl').textContent=thDate(D.dates[S.frame],false); drawMap(null,0); }

/* ---------- main update ---------- */
function update(){
  const c=compute(), dm=distCompute();
  drawKpis(c); drawMap(c.byProv,c.total); drawCharts(c); drawTables(c,dm); drawChip();
  $('subtitle').textContent = 'ข้อมูลรายงานวันที่ '+thDate(D.dates[0],true)+' – '+thDate(D.dates[ND-1],true)+' · ทั้งหมด '+fmt(D.meta.total)+' ราย';
}

$('foot').innerHTML =
  'แหล่งข้อมูล: ไฟล์รายงานผู้ป่วยยืนยันโควิด-19 รายบุคคล (confirmed-cases-since-120465) · ' +
  'ข้อมูลถูกสรุปเป็นรายวัน × จังหวัด × เพศ × กลุ่มอายุ × ปัจจัยเสี่ยง และฝังไว้ในไฟล์นี้ ไม่มีข้อมูลระบุตัวบุคคล<br>' +
  'ข้อจำกัด: (1) แผนที่ใช้วงกลมที่จุดกลางจังหวัด ไม่ใช่ขอบเขตการปกครอง และใช้จำนวนราย ไม่ใช่อัตราต่อประชากร ' +
  '(2) ข้อมูล "จังหวัดที่เริ่มป่วย" ขาดหาย ' + fmt(D.meta.onsMissing) + ' ราย และมีค่าที่ไม่ใช่จังหวัดในไทย ' + fmt(D.meta.onsOther) + ' ราย จึงไม่รวมในโหมดนี้ ' +
  '(3) ปัจจัยเสี่ยงถูกจัดกลุ่มใหม่จากข้อความเดิม (4) อำเภอ 250 แห่งที่มีผู้ป่วยสูงสุดเท่านั้น และอำเภอที่ชื่อ "เมือง" เป็นอำเภอเมืองของจังหวัดนั้น ' +
  '(5) อายุที่ผิดปกติ (>110 ปี) ถูกจัดเป็นไม่ทราบ ผู้ป่วยอายุต่ำกว่า 1 ปีนับเป็นกลุ่ม 0–4 ปี';

update();
loadGeo();
})();
</script>
