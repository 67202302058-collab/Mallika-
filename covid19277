function normName(s){
  s=String(s==null?'':s).replace(/[\s\u200b]+/g,'').replace(/^จังหวัด/,'').replace(/^จ\./,'');
  if(/^กรุงเทพ/.test(s)||/bangkok/i.test(s)) s='กรุงเทพมหานคร';
